
vendor/
!_sass/vendor/
_site/
assets/lib

# Project management and internal documentation
*.backup
*.tmp
*.temp
*~

# SCSS backup and legacy files
_sass/*-backup.scss
_sass/*-legacy.scss

# WebM backup files
assets/images/backups/

# Build artifacts
.sass-cache/
__pycache__/
.jekyll-cache/
.jekyll-metadata
.bundle/
node_modules/

# Runtime caches written by enrichment scripts
scripts/*hltb-failed-cache.json

# Archive directory (keep archived files in git for recovery)
# _archive/ - commented out to track archived files

# All documentation and project management files (exclude from version control)
# Anchored with a leading slash so it matches only the notes folder at the repo
# root. Unanchored, it matched any directory named docs at any depth, which
# silently swallowed _includes/docs/ and would have shipped a broken site.
/docs/

# Generated from the junk-docs repo by scripts/import-docs.py.
# Edit the docs there, not here — these are overwritten on every run.
_docs/
assets/images/docs/

# Draft files should never be committed
_drafts/
# Performance monitoring and optimization files
performance-*.json
lighthouse-*.json
lighthouse-reports/
image-analysis-report.txt
build.log


.playwright-mcp/
assets/data/games/

# Environment variables — never commit secrets
.env
.env.local
.env.*.local
